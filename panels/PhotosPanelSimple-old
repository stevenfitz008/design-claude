        result = await unsplashService.searchPhotos({
          query,
          page: pageNum,
          per_page: 20
        });
        const newPhotos = result.results;
        
        // Check if we have more photos to load
        if (!newPhotos || newPhotos.length === 0) {
          setHasMore(false);
        } else if (newPhotos.length < 20) {
          setHasMore(false);
        }
        
