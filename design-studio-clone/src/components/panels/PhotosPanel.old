const renderOption: ItemRenderer<{ value: string; label: string }> = (
  option,
  { handleClick, modifiers }
) => {
  return (
    <MenuItem
      active={modifiers.active}
      key={option.value}
      onClick={handleClick}
      text={option.label}
    />
  );
};

