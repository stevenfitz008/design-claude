          setPhotos(prev => {
            const existingIds = new Set(prev.map(photo => photo.id));
            const uniqueNewPhotos = (newPhotos || []).filter(photo => !existingIds.has(photo.id));
            return [...prev, ...uniqueNewPhotos];
          });
        }
