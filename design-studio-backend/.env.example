# Application Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Database Configuration - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=design_studio
POSTGRES_USER=design_studio_user
POSTGRES_PASSWORD=design_studio_password
DATABASE_URL="postgresql://design_studio_user:design_studio_password@localhost:5432/design_studio"

# Database Configuration - MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=design_studio_canvas
MONGODB_USER=design_studio_user
MONGODB_PASSWORD=design_studio_password
MONGODB_URL="mongodb://design_studio_user:design_studio_password@localhost:27017/design_studio_canvas"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=design_studio_redis_password
REDIS_URL="redis://:design_studio_redis_password@localhost:6379"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Third-Party API Keys
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
PEXELS_API_KEY=your-pexels-api-key
GOOGLE_FONTS_API_KEY=your-google-fonts-api-key

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=design-studio-assets
CDN_DOMAIN=https://your-cdn-domain.com
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
UNSPLASH_SECRET_KEY=your-unsplash-secret-key
GOOGLE_FONTS_API_KEY=your-google-fonts-api-key
OPENAI_API_KEY=your-openai-api-key
STABILITY_AI_API_KEY=your-stability-ai-api-key

# AWS Configuration (for S3 file storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=design-studio-uploads
AWS_CLOUDFRONT_URL=https://your-cloudfront-domain.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_TTL=300
RATE_LIMIT_AUTH_MAX=5

# File Upload Limits
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=10
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,svg
ALLOWED_VIDEO_TYPES=mp4,webm,gif

# Cache Configuration
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=86400

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info
METRICS_ENABLED=true

# WebSocket Configuration
WS_PORT=3002
WS_PATH=/socket.io
WS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173